#!/bin/sh
set -e

# Fanne Linux — auto/config
#
# This script is the single source of truth for how `lb config` is invoked.
# It replaces an implicit/default `--mode debian` invocation (which produced
# a malformed /etc/apt/sources.list when combined with a Devuan mirror and
# the "ceres" suite) with an explicit Devuan configuration, matching what
# docs/architecture.md describes: Fanne Linux is a Devuan Ceres derivative
# (sysvinit + elogind), not a Debian Sid image.
#
# Usage: run `lb config` from the repository root; live-build sources this
# file automatically. Do not call this script directly.

REPOSITORY_ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
# shellcheck source=../version
. "$REPOSITORY_ROOT/version"

FANNE_VOLUME_ID=$(printf '%s' "FANNE_${FANNE_CODENAME}_${FANNE_VERSION}" | tr '[:lower:].' '[:upper:]_')

MIRROR="http://pkgmaster.devuan.org/merged"
ARCHITECTURE="amd64"
# non-free-firmware carries firmware-amd-graphics, firmware-iwlwifi,
# firmware-realtek, etc. — it does exist on Devuan's merged mirror
# (deb.devuan.org/merged ceres main contrib non-free non-free-firmware),
# an earlier comment here claiming otherwise was wrong.
# contrib is needed for virtualbox-guest-x11 (VirtualBox Guest Additions
# packages live there upstream, same as on Debian).
ARCHIVE_AREAS="main contrib non-free-firmware"

# NOTE: --distribution ceres is written literally (not via a variable).
# scripts/check.sh greps auto/config for the literal string
# "--distribution ceres" to confirm this image targets Devuan Ceres —
# keep it inline here rather than reintroducing a DISTRIBUTION variable.
# cron-daemon-common is part of debootstrap's own base package set (it
# lands in the chroot before config/package-lists is even consulted) and
# depends on "systemd | systemd-standalone-sysusers | systemd-sysusers" to
# process sysusers.d entries. On a sysvinit image we obviously can't
# satisfy that with systemd itself, so we need systemd-standalone-sysusers
# pulled in at bootstrap time (live-build has no dedicated --bootstrap-
# include flag; --include= below passes debootstrap's own flag straight
# through).
#
# --include= alone isn't enough, though: debootstrap installs its base
# package set in a fixed sequence, not a real dependency-resolved order,
# so cron-daemon-common's configure step can run before
# systemd-standalone-sysusers has been configured, and dpkg fails with
# "dependency problems prevent configuration of cron-daemon-common" even
# though the package it needs is right there in the same batch (a known
# debootstrap limitation with alternative "X | Y | Z" depends — see
# https://dev1galaxy.org/viewtopic.php?id=6340). So we additionally
# --exclude=cron,cron-daemon-common from debootstrap's base install, and
# add "cron" to config/package-lists/fanne.list.chroot instead: live-build
# installs that list with a normal apt-get, which does real dependency
# resolution and runs after systemd-standalone-sysusers is already
# configured in the chroot.
lb config noauto \
    --mode devuan \
    --distribution ceres \
    --architectures "${ARCHITECTURE}" \
    --archive-areas "${ARCHIVE_AREAS}" \
    --initsystem sysvinit \
    --image-name fanne-linux \
    --debootstrap-options "--include=systemd-standalone-sysusers --exclude=cron,cron-daemon-common" \
    \
    --parent-mirror-bootstrap "${MIRROR}" \
    --mirror-bootstrap "${MIRROR}" \
    --parent-mirror-chroot "${MIRROR}" \
    --mirror-chroot "${MIRROR}" \
    --parent-mirror-binary "${MIRROR}" \
    --mirror-binary "${MIRROR}" \
    \
    --security false \
    --updates false \
    --apt-indices false \
    --apt-source-archives false \
    \
    --binary-images iso-hybrid \
    --bootloaders "grub-pc,grub-efi" \
    --uefi-secure-boot disable \
    --debian-installer none \
    \
    --linux-packages "linux-image" \
    --memtest none \
    \
    --iso-application "Fanne Linux ${FANNE_CODENAME} ${FANNE_VERSION}" \
    --iso-publisher "Tervia Interactive" \
    --iso-volume "$FANNE_VOLUME_ID" \
    --bootappend-live "boot=live components username=fanne user-fullname=Fanne hostname=fanne locales=en_US.UTF-8 keyboard-layouts=us timezone=UTC" \
    \
    "${@}"

#!/bin/sh

set -eu

printf '%s\n' 'fanne' > /etc/hostname

if [ -f /etc/hosts ]; then
    sed -i 's/127\.0\.1\.1.*/127.0.1.1\tfanne/' /etc/hosts
fi

if command -v update-alternatives >/dev/null 2>&1; then
    update-alternatives --set x-session-manager /usr/bin/startxfce4 || true
fi

systemctl enable NetworkManager.service
systemctl enable lightdm.service

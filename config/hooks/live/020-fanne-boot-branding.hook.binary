#!/bin/sh

set -eu

# Current live-build releases run binary hooks from inside the binary tree,
# while older releases run them from the project root.
if [ -d binary ]; then
    BINARY_ROOT='binary'
else
    BINARY_ROOT='.'
fi

SPLASH="$BINARY_ROOT/fanne-splash.png"

for target in \
    "$BINARY_ROOT/isolinux/splash.png" \
    "$BINARY_ROOT/boot/grub/splash.png" \
    "$BINARY_ROOT/boot/grub/live-theme/splash.png"
do
    if [ -d "$(dirname "$target")" ]; then
        cp "$SPLASH" "$target"
    fi
done

rm -f "$SPLASH"

# Remove upstream distribution names from generated BIOS and UEFI menus.
find "$BINARY_ROOT" -type f \( -name '*.cfg' -o -name '*.txt' \) -exec \
    sed -i \
        -e 's/Debian GNU\/Linux/Fanne Linux/g' \
        -e 's/Debian Live/Fanne Linux/g' \
        -e 's/Debian/Fanne Linux/g' \
        {} +

mkdir -p "$BINARY_ROOT/.disk"
printf '%s\n' "Fanne Linux ${FANNE_CODENAME:-Unstable} ${FANNE_VERSION:-} - Official AMD64 Live Image" > "$BINARY_ROOT/.disk/info"

# Show our own codename/version where live-build's isolinux menu prints its
# generic "Boot menu" title, instead of a separate line on the splash image
# (which used to collide with the vesamenu title box at that same position).
if [ -n "${FANNE_CODENAME:-}" ] && [ -n "${FANNE_VERSION:-}" ]; then
    find "$BINARY_ROOT" -type f -name '*.cfg' -exec \
        sed -i \
            -E "s/^([[:space:]]*[Mm][Ee][Nn][Uu][[:space:]]+[Tt][Ii][Tt][Ll][Ee][[:space:]]+)Boot menu\$/\\1Fanne Linux ${FANNE_CODENAME} ${FANNE_VERSION}/" \
            {} +
fi

#!/bin/sh

set -eu

SPLASH='config/bootloaders/fanne-splash.png'

# Current live-build releases run binary hooks from inside the binary tree,
# while older releases run them from the project root.
if [ -d binary ]; then
    BINARY_ROOT='binary'
else
    BINARY_ROOT='.'
fi

for target in \
    "$BINARY_ROOT/isolinux/splash.png" \
    "$BINARY_ROOT/boot/grub/splash.png" \
    "$BINARY_ROOT/boot/grub/live-theme/splash.png"
do
    if [ -d "$(dirname "$target")" ]; then
        cp "$SPLASH" "$target"
    fi
done

# Remove upstream distribution names from generated BIOS and UEFI menus.
find "$BINARY_ROOT" -type f \( -name '*.cfg' -o -name '*.txt' \) -exec \
    sed -i \
        -e 's/Debian GNU\/Linux/Fanne Linux/g' \
        -e 's/Debian Live/Fanne Linux/g' \
        -e 's/Debian/Fanne Linux/g' \
        {} +

mkdir -p "$BINARY_ROOT/.disk"
printf '%s\n' 'Fanne Linux Unstable - Official AMD64 Live Image' > "$BINARY_ROOT/.disk/info"
